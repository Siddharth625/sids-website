# Powers the "Ask about me" section (src/app/api/chat/route.ts).
# Create a key at https://openrouter.ai/keys, then copy this file to
# .env.local and paste it in. .env.local is gitignored.
#
# Anyone who opens the page can spend against this key, so set a credit
# limit on it in the OpenRouter dashboard before you deploy. The route's
# own rate limit is in-memory and resets whenever a serverless instance
# recycles, so it slows abuse down rather than capping spend.
OPENROUTER_API_KEY=

# Lead capture behind the assistant's question limit
# (src/app/api/contact/route.ts). Create a key at
# https://resend.com/api-keys. Without it the form returns a 503 and
# the lead is written to the server log rather than lost silently.
RESEND_API_KEY=

# Optional. Resend only sends from a domain you have verified; until
# yours is, leave this unset and it falls back to Resend's sandbox
# sender, which can only deliver to your own account address.
CONTACT_FROM=
